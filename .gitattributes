# =============================================================================
# 《道枢罗盘》换行符与文本规范化
# -----------------------------------------------------------------------------
# 背景：CI 运行在 ubuntu-latest，shell 脚本若带 CRLF 会报
#       `bash: $'\r': command not found` 或 `set -euo pipefail\r` 解析失败。
# 本文件强制仓库内统一以 LF 存储，避免 Windows（core.autocrlf=true）检出后
# 把 CRLF 提交进仓库。
# =============================================================================

# 默认：文本文件按内容自动识别，仓库内统一使用 LF
* text=auto eol=lf

# Shell 脚本与 Gradle Wrapper：必须以 LF 存储并在检出时保持 LF
*.sh      text eol=lf
gradlew   text eol=lf
*.bash    text eol=lf

# Windows 批处理：仓库内仍以 LF 存储（保持一致性），检出时使用 CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf

# 二进制文件：不做任何换行转换
*.jar     binary
*.jks     binary
*.keystore binary
*.apk     binary
*.aab     binary
*.png     binary
*.webp    binary
*.ttf     binary
*.otf     binary

# 明确标记为二进制，避免 diff/merge 处理
gradle/wrapper/gradle-wrapper.jar binary
