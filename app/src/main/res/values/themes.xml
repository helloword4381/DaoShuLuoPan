<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 基础主题：仅提供 Activity 启动所需的 XML 主题，实际 UI 由 Compose 绘制 -->
    <style name="Theme.DaoShuCompass" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/brand_ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <!-- Android 15（API 35）强制 edge-to-edge，Compose 侧用 WindowInsets 处理避让 -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
    </style>

    <!-- 启动主题：冷启动第一帧使用背景色，避免白屏 -->
    <style name="Theme.DaoShuCompass.Splash" parent="Theme.DaoShuCompass">
        <item name="android:windowBackground">@drawable/bg_splash</item>
    </style>
</resources>
